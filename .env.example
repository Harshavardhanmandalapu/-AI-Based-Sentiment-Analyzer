# MongoDB connection. Local Docker Compose works with these defaults.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=sentiment_analyzer
MONGO_COLLECTION=analyses

# Hugging Face model. The first analysis downloads the model if it is not cached.
MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
# auto = use CUDA when available, otherwise CPU. You can also set cpu or cuda.
MODEL_DEVICE=auto

# Flask settings
FLASK_DEBUG=false
SECRET_KEY=replace-this-with-a-long-random-secret
